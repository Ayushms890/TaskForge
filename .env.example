NODE_ENV=development
# Hosted platforms usually provide PORT automatically; local development uses API_PORT.
PORT=
API_PORT=4000
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_URL_ENCODED_DB_PASSWORD@localhost:5432/taskforge?schema=public
JWT_SECRET=replace-with-a-long-random-development-secret
JWT_EXPIRES_IN=15m
JWT_ISSUER=taskforge-api
JWT_AUDIENCE=taskforge-web
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
TRUST_PROXY=false
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Optional: reserved for the future Docker deployment workflow.
POSTGRES_USER=YOUR_DB_USER
POSTGRES_PASSWORD=YOUR_DB_PASSWORD
POSTGRES_DB=taskforge
